# OpenAI-compatible Chat Completions provider.
# The runner appends /chat/completions to TOOL_ROUTING_API_BASE_URL.
TOOL_ROUTING_API_BASE_URL=https://provider.example/v1

# Alternatively, set a complete endpoint and comment out API_BASE_URL above.
# TOOL_ROUTING_API_URL=https://provider.example/v1/chat/completions

TOOL_ROUTING_API_KEY=replace-me
TOOL_ROUTING_MODEL=deepseek-v4-flash
TOOL_ROUTING_THINKING_MODE=disabled

# Provider-specific request fields used by the recorded full-v1 run.
TOOL_ROUTING_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
