[Unit]
Description=TencentDB Agent Memory Panel
Requires=tdai-memory-knowledge.service
After=tdai-memory-knowledge.service
PartOf=tdai-memory.target

[Service]
Type=simple
User=tdai-memory
Group=tdai-memory
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-component.sh panel
ExecStartPost=@ROOT@/scripts/wait-health.sh panel
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=tdai-memory.target
