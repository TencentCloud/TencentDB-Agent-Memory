[Unit]
Description=TencentDB Agent Memory Knowledge
Requires=tdai-memory-core.service
After=tdai-memory-core.service
PartOf=tdai-memory.target

[Service]
Type=simple
User=tdai-memory
Group=tdai-memory
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/run-component.sh knowledge
ExecStartPost=@ROOT@/scripts/wait-health.sh knowledge
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=tdai-memory.target
