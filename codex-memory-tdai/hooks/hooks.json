{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/health.sh\"",
            "statusMessage": "Memory gateway check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/recall.sh\"",
            "timeout": 15,
            "statusMessage": "Recalling memories"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh\"",
            "timeout": 30,
            "statusMessage": "Recording conversation"
          }
        ]
      }
    ]
  }
}
