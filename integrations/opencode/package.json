    "opencode-plugin",
    "memory",
    "ai-memory",
    "tencentdb"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.10"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.2"
  }
}
