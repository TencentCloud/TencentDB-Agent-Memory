# Knowledge Service 配置
# 用法：cp .env.example .env && 编辑 .env
# .env 由 src/config.ts 顶部的 `import 'dotenv/config'` 自动加载

# ═══ HTTP Server ═══
PORT=8421
API_PREFIX=/v3
LOG_LEVEL=debug

# ═══ 服务间鉴权 ═══
# 留空（默认）= 不启用鉴权，所有 /v3 端点开放（仅适合本机开发）。
# 非空 = 除只读白名单（tools/*、wiki/code-graph 查询、source-credential/status、
# auto-sync/status 等）外的端点均要求 `Authorization: Bearer <KNOWLEDGE_SERVICE_KEY>`。
# 生产/共享部署必须设置；deploy/global-images 启动脚本会自动生成并分发给 Panel。
# KNOWLEDGE_SERVICE_KEY=

# ═══ 数据存储 ═══
# 数据根目录：git clone、wiki 素材、BM25 索引、SQLite 都在此目录下
KNOWLEDGE_DATA_DIR=./data
# SQLite 数据库路径（7 张表：knowledge_wiki / knowledge_code_graph /
# knowledge_git_credential / *_audit）
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ═══ Git 私有仓库接入（Code-Graph） ═══
# 托管凭证的加密主密钥。**留空 = 关闭托管凭证能力**：/v3/source-credential/create
# 返回 503，且已绑定了凭证的 code-graph 会构建失败（不会静默降级为匿名访问）。
# 要求 ≥32 字节的高熵随机值，生成方式：
#   openssl rand -base64 32
# 轮换/丢失此 key 会导致已有凭证无法解密 —— 请与数据库一起备份。
# 建议：已配置此 key 时同时设置 KNOWLEDGE_SERVICE_KEY，否则凭证接口在无鉴权下暴露。
# KNOWLEDGE_SECRET_KEY=

# 允许访问**内网 / 私有地址**的 git host 白名单（逗号分隔）。
# 默认空 = 沿用 SSRF 黑名单（10./172.16-31./192.168./127./169.254./::1/fe80:/fc00::/7
# 等一律拒绝）。企业内网 GitLab / Gitea 必须在这里显式声明，而不是关掉整个 SSRF 校验。
# 语法：只写 host（不写端口）；支持精确 host 与 `*.suffix` 单层通配。
#   KNOWLEDGE_GIT_ALLOWED_HOSTS=gitlab.corp.example.com,*.internal.example.com
# 注意：`*.corp.example.com` 只匹配一层 label，`x.corp.example.com.attacker.com`
# 与 `evilcorp.example.com` 都不会命中。
KNOWLEDGE_GIT_ALLOWED_HOSTS=

# SSH host key 校验：false（默认）= StrictHostKeyChecking=accept-new（首次信任 TOFU，
# 之后按 known_hosts 校验，文件在 {KNOWLEDGE_DATA_DIR}/_git_known_hosts/known_hosts）；
# true = StrictHostKeyChecking=yes（需要运维预置 known_hosts，否则首次连接即失败）。
KNOWLEDGE_GIT_STRICT_HOST_KEY=false

# ═══ LLM 配置（wiki ingest 必需，code-graph 不依赖） ═══
# LLM_MODE：全局默认路由（per-instance llm_binding 永远优先于此）
#   proxy（默认）：走云端 Proxy，用 TMC 推送的 knowledge-service key 计费。
#                  KS 本地无需启动 Proxy；没绑定则报错（不静默直连）。
#   custom       ：用下面的 LLM_BASE_URL/LLM_API_KEY 直连自带端点（BYO）。
LLM_MODE=proxy
LLM_PROVIDER=custom
LLM_MODEL=Memory-Model
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# 仅 LLM_MODE=custom 时需要；请在运行环境中注入 LLM API 凭据。
LLM_BASE_URL=

# ═══ MCP Server（src/mcp/server.ts 专用） ═══
# MCP server 通过 HTTP 调用本服务 API，这里配置转发目标
KNOWLEDGE_API_URL=http://localhost:8421
# KNOWLEDGE_API_TOKEN=optional-bearer-token

# ═══ 与管控（team-memory-control）对接 ═══
# TMC + KS 部署时以下两项必须显式配置。代码中的默认值均为空：
# - PUBLIC_BASE_URL 必须是 Agent 可访问、且包含 /v3 的地址；
# - CALLBACK_URL 只能是 TMC 根地址，程序会自动追加 /api/v1/knowledge/status-callback。
# Docker 部署请用 CLI：--public-url / --tmc-callback（见 docs/deployment.md）
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8421/v3
TMC_CALLBACK_URL=http://localhost:8123

# 管控侧配置（不在本服务读取）：
#   KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421

# ═══ Wiki ingest 并发（可选） ═══
# 单 wiki 内阶段1 并发 LLM 抽取数，默认 3，clamp 1~10
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3
# 全局 LLM 最大并发（跨所有 wiki 的 extract + merge），默认 5，clamp 1~20
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5

# ═══ ClickHouse 工具调用埋点（可选，默认关闭） ═══
# 仅采集 POST /v3/tools/call；写入与 Memory/Skill 共用结构的 tool_call_logs。
# 请求正文会递归脱敏并截断到 512 bytes；写入失败不影响 Knowledge 请求。
KNOWLEDGE_CLICKHOUSE_ENABLED=false
KNOWLEDGE_CLICKHOUSE_URL=http://127.0.0.1:8123
KNOWLEDGE_CLICKHOUSE_DATABASE=default
KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
KNOWLEDGE_CLICKHOUSE_USER=default
# 启用鉴权时，请在运行环境中注入 ClickHouse 密码。
KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ═══ Code-Graph 定时自动同步 ═══
# 定时扫描所有 ready 状态的 code-graph, FIFO 队列 + worker pool 拉最新 git
# 并重建索引。默认关闭；开启后单仓库同步频率 = max(单次 sync 耗时, SCAN 周期)。
# 观测: GET /v3/auto-sync/status | 手动触发: POST /v3/auto-sync/trigger
KNOWLEDGE_AUTO_SYNC_ENABLED=false
# 扫描周期（分钟），clamp 1~60
KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10
# 并发 worker 数（同时最多几个仓库在同步），clamp 1~20
KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3
