# Copy this file to .env outside version control or export the variables locally.
# Never commit real credentials.
PROMPT_CACHE_BENCH_BASE_URL=https://api.deepseek.com/v1
# Prefer the file option for local runs. The file must have mode 0600.
PROMPT_CACHE_BENCH_API_KEY_FILE=
# Direct environment fallback; never commit a real value.
PROMPT_CACHE_BENCH_API_KEY=
PROMPT_CACHE_BENCH_MODEL=deepseek-v4-pro
PROMPT_CACHE_BENCH_TURNS=6
PROMPT_CACHE_BENCH_DELAY_MS=3000
PROMPT_CACHE_BENCH_ORDER=legacy,optimized
PROMPT_CACHE_BENCH_RESULT_DIR=benchmark-runs/issue-120
