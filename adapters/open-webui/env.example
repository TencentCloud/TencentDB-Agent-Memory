# Open WebUI environment (docker run -e ... / .env / WebUI env file)
# Docs: https://docs.openwebui.com/reference/env-configuration
# Core connection (chat + background tasks):
OPENAI_API_BASE_URL=http://127.0.0.1:8096/codebuddy/default
OPENAI_API_KEY=sk-mem-...   # your business user key — prefer the env file over hardcoding
# Optional: model used for title / follow-up generation via the same proxy:
TASK_MODEL_EXTERNAL=claude-sonnet-4-20250514
