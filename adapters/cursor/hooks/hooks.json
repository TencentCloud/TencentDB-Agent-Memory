{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node ./scripts/hook.mjs", "timeout": 15, "failClosed": false }
    ],
    "beforeSubmitPrompt": [
      { "command": "node ./scripts/hook.mjs", "timeout": 5, "failClosed": false }
    ],
    "afterAgentResponse": [
      { "command": "node ./scripts/hook.mjs", "timeout": 15, "failClosed": false }
    ],
    "sessionEnd": [
      { "command": "node ./scripts/hook.mjs", "timeout": 10, "failClosed": false }
    ]
  }
}
