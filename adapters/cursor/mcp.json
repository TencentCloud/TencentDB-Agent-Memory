{
  "mcpServers": {
    "tencentdb-agent-memory": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/mcp-server.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "TDAI_GATEWAY_URL": "${TDAI_GATEWAY_URL}",
        "TDAI_GATEWAY_API_KEY": "${TDAI_GATEWAY_API_KEY}",
        "TDAI_CURSOR_AGENT_ID": "${TDAI_CURSOR_AGENT_ID}"
      }
    }
  }
}
