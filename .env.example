# TDAI Memory Hub 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# LLM配置（必需）
LLM_MODE=custom
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2
LLM_PROVIDER=custom
LLM_PROTOCOL=openai
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# 其他可选配置
# LOG_LEVEL=info
# NODE_ENV=production