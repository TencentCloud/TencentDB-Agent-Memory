{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],

    "noEmit": true
  },
  "include": ["index.ts", "src/**/*.ts", "bin/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
