{
  // Probes were typechecked by NOTHING until tz-07 round 5: tsconfig.check.json
  // sees only src/, so a changed signature left four probe call sites stale and
  // silently wrong (a runId landed in the root slot and wrote ./run-1/). They
  // run under tsx, hence allowImportingTsExtensions for the `./assert.mts`
  // imports.
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // The ambient module declarations live under src/gateway; `include` is
  // replaced (not merged) by `extends`, so they have to be named again or the
  // optional deps they stub (node-llama-cpp, openclaw/plugin-sdk) come back as
  // TS2307.
  //
  // index.ts is deliberately NOT here, and this is a stated limitation, not an
  // oversight: it imports src/offload, a legacy subtree no typecheck config
  // covers (25 pre-existing errors — implicit any from the SDK stubs plus
  // uninitialised fields). Bringing it in is its own task. The one thing this
  // gate would have watched there — allowLegacyFallback on the injected
  // openclaw root, index.ts:254 — is covered by the openclaw test, which fails
  // if that root stops inheriting.
  "include": ["scripts/**/*.mts", "scripts/*.ts", "src/**/*.d.ts"]
}
